# No remote AI calls by default. Set true ONLY after privacy/legal approval.
ALLOW_REMOTE_LLM=false
# A request must ALSO contain remoteConsent:true. Never commit real credentials.
OPENAI_API_KEY=
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=customer-agent
KAFKA_GROUP_ID=customer-agent-group
INPUT_TOPIC=customer.requests
OUTPUT_TOPIC=customer.decisions
